# Copy this file to `.env` and paste your keys in. Never commit `.env`.

# 1. Anthropic — https://console.anthropic.com  (API keys → Create key)
ANTHROPIC_API_KEY=sk-ant-...

# 2. Telegram — message @BotFather in Telegram, send /newbot
TELEGRAM_BOT_TOKEN=1234567890:AA...

# 3. Adzuna job search — https://developer.adzuna.com/signup  (free, 1000 calls/month)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
